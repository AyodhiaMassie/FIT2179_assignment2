{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Malaysia internet usage over time from 2000 to 2024.",
  "width": 440,
  "height": 360,
  "background": "transparent",
  "data": {
    "url": "/datasets/malaysia_internet_usage_overtime.csv"
  },
  "config": {
    "background": null,
    "axis": { 
      "labelColor": "#475569",
      "titleColor": "#475569",
      "gridColor": "#e5e7eb",
      "domainColor": "#cbd5e1",
      "tickColor": "#cbd5e1",
      "labelFont": "Arial",
      "titleFont": "Arial",
      
      "labelFontSize": 16,
      "titleFontSize": 20,

      "titlePadding": 14,
      "labelPadding": 6
    },
    "view": {
      "stroke": null,
      "fill": "transparent"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "color": "#93c5fd",
        "opacity": 0.18
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "scale": {"domain": [2000, 2024]},
          "axis": {"title": "Year", "format": "d", "values": [2000, 2004, 2008, 2012, 2016, 2020, 2024]}
        },
        "y": {
          "field": "usage",
          "type": "quantitative",
          "scale": {"domain": [0, 100]},
          "axis": {
            "title": "Internet users (% of population)",
            "format": ".0f"
          }
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "strokeWidth": 4,
        "color": "#2563eb"
      },
      "encoding": {
        "x": {"field": "year", "type": "quantitative"},
        "y": {"field": "usage", "type": "quantitative"},
        "tooltip": [
          {"field": "year", "type": "quantitative", "title": "Year", "format": "d"},
          {"field": "usage", "type": "quantitative", "title": "Internet users (%)", "format": ".1f"}
        ]
      }
    },
    {
      "transform": [
        {"filter": "datum.year == 2000 || datum.year == 2024"}
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 90,
        "color": "#ffffff",
        "stroke": "#2563eb",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {"field": "year", "type": "quantitative"},
        "y": {"field": "usage", "type": "quantitative"}
      }
    },
    {
      "transform": [
        {"filter": "datum.year == 2000 || datum.year == 2024"},
        {"calculate": "format(datum.usage, '.1f') + '%'", "as": "label"}
      ],
      "mark": {
        "type": "text",
        "dy": -16,
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#2563eb"
      },
      "encoding": {
        "x": {"field": "year", "type": "quantitative"},
        "y": {"field": "usage", "type": "quantitative"},
        "text": {"field": "label"}
      }
    }
    
  ]
}