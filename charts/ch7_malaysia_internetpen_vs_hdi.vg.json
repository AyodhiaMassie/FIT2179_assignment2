{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Scatterplot showing the relationship between internet penetration and HDI across selected Asian countries in 2023.",
  "width": 350,
  "height": 420,
  "background": "transparent",
  "data": {
    "url": "datasets/internet_pen_vs_hdi.csv"
  },
  
  "layer": [
    {
  "transform": [
    {
      "filter": "isValid(datum.internet_penetration) && isValid(datum.hdi)"
    },
    {
      "regression": "hdi",
      "on": "internet_penetration",
      "method": "linear"
    }
  ],
  "mark": {
    "type": "line",
    "color": "#3B6EA8",
    "strokeWidth": 3
  },
  "encoding": {
    "x": {
      "field": "internet_penetration",
      "type": "quantitative"
    },
    "y": {
      "field": "hdi",
      "type": "quantitative"
    }
  }
},
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 95,
        "opacity": 0.9,
        "stroke": "white",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "field": "internet_penetration",
          "type": "quantitative",
          "scale": {"domain": [40, 100]},
          "axis": {
            "title": "Internet penetration (% of population)",
            "grid": true,
            "values": [40, 50, 60, 70, 80, 90, 100]
          }
        },
        "y": {
          "field": "hdi",
          "type": "quantitative",
          "scale": {"domain": [0.5, 1.0]},
          "axis": {
            "title": "Human Development Index (HDI)",
            "grid": true
          }
        },
        "color": {
          "condition": {
            "test": "datum.country == 'Malaysia'",
            "value": "#E94F4F"
          },
          "value": "#5BB8B1"
        },
        "tooltip": [
          {"field": "country", "type": "nominal", "title": "Country"},
          {"field": "internet_penetration", "type": "quantitative", "title": "Internet penetration", "format": ".1f"},
          {"field": "hdi", "type": "quantitative", "title": "HDI", "format": ".3f"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 7,
        "fontSize": 10,
        "color": "#333333"
      },
      "encoding": {
        "x": {
          "field": "internet_penetration",
          "type": "quantitative"
        },
        "y": {
          "field": "hdi",
          "type": "quantitative"
        },
        "text": {
          "field": "country"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titleFontWeight": "bold",
      "gridColor": "#E6E6E6",
      "domainColor": "#CCCCCC",
      "tickColor": "#CCCCCC"
    }
  }
}
