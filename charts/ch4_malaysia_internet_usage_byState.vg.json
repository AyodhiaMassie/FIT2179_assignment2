{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 400,
  "height": 500,

  "data": {
    "url": "datasets/malaysia_states.geojson",
    "format": {
      "type": "json",
      "property": "features"
    }
  },

  "transform": [
    {
      "lookup": "properties.name",
      "from": {
        "data": {
          "url": "datasets/malaysia_internet_usage_byState.csv"
        },
        "key": "state",
        "fields": ["internet_usage"]
      }
    }
  ],

  "mark": {
  "type": "geoshape",
  "stroke": "#ffffff",
  "strokeWidth": 1
},

"encoding": {
  "color": {
    "field": "internet_usage",
    "type": "quantitative",

    "scale": {
      "range": [
        "#d9f0d3",
        "#a6dba0",
        "#5aae61",
        "#1b7837",
        "#00441b"
      ]
    },

    "title": "Internet Usage (%)"
  },

  "tooltip": [
    {
      "field": "properties.name",
      "title": "State"
    },
    {
      "field": "internet_usage",
      "title": "Internet Usage (%)"
    }
  ]
},

  "projection": {
    "type": "mercator"
  }
}