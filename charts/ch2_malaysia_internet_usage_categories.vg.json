{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Popular internet activities in Malaysia, comparing 2020 and 2021.",
  "width": 360,
  "height": 260,
  "background": "transparent",
  "data": {
    "url": "datasets/malaysia_internet_usage_categories.csv"
  },
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 4
  },
  "encoding": {
    "y": {
      "field": "activity",
      "type": "nominal",
      "sort": "-x",
      "axis": {
        "title": null,
        "labelFontSize": 13
      }
    },
    "x": {
      "field": "percentage",
      "type": "quantitative",
      "scale": {
        "domain": [0, 100]
      },
      "axis": {
        "title": "Share of internet users (%)",
        "format": ".0f",
        "labelFontSize": 12,
        "titleFontSize": 13
      }
    },
    "color": {
      "field": "year",
      "type": "nominal",
      "scale": {
        "range": ["#93c5fd", "#2563eb"]
      },
      "legend": {
        "title": null,
        "orient": "top",
        "labelFontSize": 13
      }
    },
    "yOffset": {
      "field": "year"
    },
    "tooltip": [
      {"field": "activity", "title": "Activity"},
      {"field": "year", "title": "Year"},
      {"field": "percentage", "title": "Percentage", "format": ".1f"}
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#475569",
      "titleColor": "#475569",
      "gridColor": "#e5e7eb",
      "domainColor": "#cbd5e1",
      "tickColor": "#cbd5e1",
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  }
}